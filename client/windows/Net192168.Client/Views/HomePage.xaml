<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Net192168.Client.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Net192168.Client.ViewModels">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            Connected, this is the panel somebody reads off to a friend: the
            address first, the name they are showing as, and how it is going.
        -->
        <Grid
            Grid.Row="0"
            Margin="16,4,16,12"
            Padding="16,12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            RowSpacing="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Ellipse
                Grid.Row="0"
                Grid.Column="0"
                Width="9"
                Height="9"
                Margin="0,0,10,0"
                VerticalAlignment="Center"
                Fill="{x:Bind ViewModel.IsConnected, Mode=OneWay, Converter={StaticResource ConnectionBrush}}" />

            <TextBlock
                Grid.Row="0"
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind ViewModel.GroupLabel, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />

            <TextBlock
                Grid.Row="0"
                Grid.Column="2"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.Status, Mode=OneWay}" />

            <!--  The address, which is the thing people type into games.  -->
            <TextBlock
                Grid.Row="1"
                Grid.Column="1"
                VerticalAlignment="Center"
                FontFamily="Consolas"
                FontSize="22"
                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                IsTextSelectionEnabled="True"
                Text="{x:Bind ViewModel.VirtualIp, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsConnected, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}" />

            <Button
                Grid.Row="1"
                Grid.Column="2"
                Width="32"
                Height="32"
                Padding="0"
                AutomationProperties.Name="Copy address"
                Background="Transparent"
                BorderThickness="0"
                Command="{x:Bind ViewModel.CopyAddressCommand}"
                ToolTipService.ToolTip="Copy address"
                Visibility="{x:Bind ViewModel.IsConnected, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}">
                <FontIcon FontSize="14" Glyph="&#xE8C8;" />
            </Button>

            <!--  The name everyone else sees, changed in place.  -->
            <TextBlock
                Grid.Row="2"
                Grid.Column="1"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.Nickname, Mode=OneWay}"
                TextTrimming="CharacterEllipsis">
                <TextBlock.Visibility>
                    <Binding Converter="{StaticResource BooleanToCollapsed}" Path="ViewModel.IsEditingNickname" />
                </TextBlock.Visibility>
            </TextBlock>

            <TextBox
                x:Name="NicknameBox"
                Grid.Row="2"
                Grid.Column="1"
                MinWidth="0"
                KeyDown="OnNicknameKeyDown"
                LostFocus="OnNicknameLostFocus"
                Text="{x:Bind ViewModel.NicknameDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Visibility="{x:Bind ViewModel.IsEditingNickname, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}" />

            <Button
                Grid.Row="2"
                Grid.Column="2"
                Width="32"
                Height="32"
                Padding="0"
                AutomationProperties.Name="Change nickname"
                Background="Transparent"
                BorderThickness="0"
                Click="OnEditNickname"
                ToolTipService.ToolTip="Change your nickname"
                Visibility="{x:Bind ViewModel.IsConnected, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}">
                <FontIcon FontSize="13" Glyph="&#xE70F;" />
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Margin="16,4,16,4"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.ListLabel, Mode=OneWay}" />

            <!--  Connected: everyone else on this network.  -->
            <ListView
                Grid.Row="1"
                Padding="8,0,8,8"
                ItemsSource="{x:Bind ViewModel.Peers, Mode=OneWay}"
                SelectionMode="None"
                Visibility="{x:Bind ViewModel.IsConnected, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Padding" Value="10,8" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:PeerItem">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="64" />
                            </Grid.ColumnDefinitions>

                            <Ellipse
                                Grid.Column="0"
                                Width="7"
                                Height="7"
                                VerticalAlignment="Center"
                                Fill="{x:Bind IsReachable, Converter={StaticResource ConnectionBrush}}" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="{x:Bind Nickname}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontFamily="Consolas"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind VirtualIp}" />
                            <TextBlock
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Status}"
                                TextAlignment="Right" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!--  Disconnected: the groups you can walk into.  -->
            <ListView
                Grid.Row="1"
                Padding="8,0,8,8"
                ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}"
                SelectionMode="None"
                Visibility="{x:Bind ViewModel.IsConnected, Mode=OneWay, Converter={StaticResource BooleanToCollapsed}}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Padding" Value="10,8" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:GroupListItem">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Nickname, Mode=OneWay}" />
                            </StackPanel>

                            <Button
                                Grid.Column="1"
                                Click="OnConnect"
                                Content="Connect"
                                Tag="{x:Bind}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock
                Grid.Row="1"
                Margin="24,0,24,40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Nobody else has connected yet."
                TextAlignment="Center"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.ShowEmptyPeers, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}" />

            <StackPanel
                Grid.Row="1"
                Margin="24,0,24,40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="4"
                Visibility="{x:Bind ViewModel.ShowEmptyGroups, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}">
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="No groups yet" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Create one, then give its name and password to your friends."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <Grid
            Grid.Row="2"
            Padding="16,12"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.Message, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8"
                Visibility="{x:Bind ViewModel.IsConnected, Mode=OneWay, Converter={StaticResource BooleanToCollapsed}}">
                <Button Click="OnJoin" Content="Join" />
                <Button
                    Click="OnCreate"
                    Content="Create group"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>

            <Button
                Grid.Column="1"
                Command="{x:Bind ViewModel.DisconnectCommand}"
                Content="Disconnect"
                Visibility="{x:Bind ViewModel.IsConnected, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}" />
        </Grid>
    </Grid>
</Page>
