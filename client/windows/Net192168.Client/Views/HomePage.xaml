<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Net192168.Client.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Net192168.Client.ViewModels">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            Connecting means waiting on a server and then on an adapter, which
            is seconds with nothing else to show for it. The row is always here
            so that the screen does not shift when the bar appears.
        -->
        <ProgressBar
            Grid.Row="0"
            Height="3"
            MinHeight="3"
            IsIndeterminate="True"
            Visibility="{x:Bind ViewModel.IsWorking, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}" />

        <!--
            Nothing on this screen works without the daemon, so this says so
            rather than leaving every button to fail one at a time. It clears
            itself: the connection to the daemon retries on its own.
        -->
        <InfoBar
            Grid.Row="1"
            Margin="12,8,12,0"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.IsReady, Mode=OneWay, Converter={StaticResource NotBoolean}}"
            Message="Waiting for it to come back."
            Severity="Error"
            Title="The background service is not running" />

        <!--
            Closable, because a version being out is worth saying once and not
            worth standing between somebody and a game. Not once the download
            has started, because the app quits at the end of it and this is the
            only thing that says so.
        -->
        <InfoBar
            Grid.Row="1"
            Margin="12,8,12,0"
            IsClosable="{x:Bind ViewModel.Update.IsWorking, Mode=OneWay, Converter={StaticResource NotBoolean}}"
            IsOpen="{x:Bind ViewModel.HasUpdate, Mode=TwoWay}"
            Severity="Informational"
            Title="{x:Bind ViewModel.Update.Title, Mode=OneWay}">
            <InfoBar.ActionButton>
                <Button
                    Command="{x:Bind ViewModel.Update.InstallCommand}"
                    Content="Update"
                    Style="{StaticResource AccentButtonStyle}" />
            </InfoBar.ActionButton>

            <InfoBar.Content>
                <StackPanel
                    Margin="0,0,0,12"
                    Spacing="4"
                    Visibility="{x:Bind ViewModel.Update.Status, Mode=OneWay, Converter={StaticResource TextToVisibility}}">
                    <ProgressBar
                        Maximum="100"
                        Value="{x:Bind ViewModel.Update.Percent, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.Update.IsDownloading, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.Update.Status, Mode=OneWay}"
                        TextWrapping="Wrap" />

                    <HyperlinkButton
                        Padding="0,2"
                        Content="Get it on GitHub"
                        NavigateUri="{x:Bind ViewModel.Update.Url, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.Update.HasFailed, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}" />
                </StackPanel>
            </InfoBar.Content>
        </InfoBar>

        <!--
            The panel somebody reads off to a friend: the address first, the
            name they are showing as, and how it is going. There is nothing to
            put in it while no group is up, so it is not there at all.
        -->
        <Grid
            Grid.Row="2"
            Margin="16,8,16,12"
            Padding="16,12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            RowSpacing="4"
            Visibility="{x:Bind ViewModel.IsConnected, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--
                Every row's button is in this column, so they line up down the
                left edge beside the thing each one acts on.

                Everybody can leave. Only the owner has anything to change, so
                only the owner is offered the way in.
            -->
            <Button
                Grid.Row="0"
                Grid.Column="0"
                Width="28"
                Height="28"
                Margin="0,0,6,0"
                Padding="0"
                VerticalAlignment="Center"
                AutomationProperties.Name="Group"
                Background="Transparent"
                BorderThickness="0"
                ToolTipService.ToolTip="Group">
                <FontIcon
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE712;" />
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem
                            Click="OnManageGroup"
                            Text="Group settings"
                            Visibility="{x:Bind ViewModel.IsOwner, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE713;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Click="OnLeaveConnected" Text="Leave group">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE7E8;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>

            <TextBlock
                Grid.Row="0"
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind ViewModel.GroupLabel, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />

            <TextBlock
                Grid.Row="0"
                Grid.Column="2"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.Status, Mode=OneWay}" />

            <!--
                The address, which is the thing people type into games, with the
                way to copy it beside it. Pushed to the far edge of the card the
                button read as belonging to the row rather than to the address.
            -->
            <!--
                Copying leaves nothing behind on its own, so the button answers
                for itself for a moment rather than putting a line of text
                somewhere that then has to be cleared.
            -->
            <Button
                Grid.Row="1"
                Grid.Column="0"
                Width="28"
                Height="28"
                Margin="0,0,6,0"
                Padding="0"
                VerticalAlignment="Center"
                AutomationProperties.Name="Copy address"
                Background="Transparent"
                BorderThickness="0"
                Command="{x:Bind ViewModel.CopyAddressCommand}"
                ToolTipService.ToolTip="Copy address">
                <Grid>
                    <FontIcon
                        FontSize="14"
                        Glyph="&#xE8C8;"
                        Visibility="{x:Bind ViewModel.JustCopied, Mode=OneWay, Converter={StaticResource BooleanToCollapsed}}" />
                    <FontIcon
                        FontSize="14"
                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                        Glyph="&#xE73E;"
                        Visibility="{x:Bind ViewModel.JustCopied, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}" />
                </Grid>
            </Button>

            <TextBlock
                Grid.Row="1"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                VerticalAlignment="Center"
                FontFamily="Consolas"
                FontSize="22"
                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                IsTextSelectionEnabled="True"
                Text="{x:Bind ViewModel.VirtualIp, Mode=OneWay}" />

            <!--  The name everyone else sees, changed in place.  -->
            <StackPanel
                Grid.Row="2"
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="6"
                Visibility="{x:Bind ViewModel.IsEditingNickname, Mode=OneWay, Converter={StaticResource BooleanToCollapsed}}">
                <FontIcon
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE77B;" />
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.Nickname, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!--  In the same column as the others, beside the name it changes.  -->
            <Button
                Grid.Row="2"
                Grid.Column="0"
                Width="28"
                Height="28"
                Margin="0,0,6,0"
                Padding="0"
                VerticalAlignment="Center"
                AutomationProperties.Name="Change nickname"
                Background="Transparent"
                BorderThickness="0"
                Click="OnEditNickname"
                ToolTipService.ToolTip="Change your nickname"
                Visibility="{x:Bind ViewModel.IsEditingNickname, Mode=OneWay, Converter={StaticResource BooleanToCollapsed}}">
                <FontIcon FontSize="13" Glyph="&#xE70F;" />
            </Button>

            <TextBox
                x:Name="NicknameBox"
                Grid.Row="2"
                Grid.Column="1"
                MinWidth="0"
                KeyDown="OnNicknameKeyDown"
                LostFocus="OnNicknameLostFocus"
                Text="{x:Bind ViewModel.NicknameDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Visibility="{x:Bind ViewModel.IsEditingNickname, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}" />

        </Grid>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Margin="16,4,16,4"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.ListLabel, Mode=OneWay}" />

            <!--  Connected: everyone else on this network.  -->
            <ListView
                Grid.Row="1"
                Padding="8,0,8,8"
                ItemsSource="{x:Bind ViewModel.Peers, Mode=OneWay}"
                SelectionMode="None"
                Visibility="{x:Bind ViewModel.IsConnected, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Padding" Value="10,8" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <!--
                        OneWay throughout. x:Bind is OneTime unless told
                        otherwise, and these rows are updated in place rather
                        than replaced.
                    -->
                    <DataTemplate x:DataType="vm:PeerItem">
                      <Grid>
                        <!--
                            Dimmed for someone in the group who is not here. They
                            are worth showing, and not worth reading as though
                            they were online.
                        -->
                        <Grid
                            ColumnSpacing="8"
                            Opacity="{x:Bind IsHere, Mode=OneWay, Converter={StaticResource PresenceOpacity}}"
                            Visibility="{x:Bind IsNotConfirmingOwner, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>

                            <Ellipse
                                Grid.Column="0"
                                Width="7"
                                Height="7"
                                VerticalAlignment="Center"
                                Fill="{x:Bind IsReachable, Mode=OneWay, Converter={StaticResource ConnectionBrush}}" />
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="5">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="{x:Bind Nickname, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                                <!--  Whose group it is, so people know who to ask.  -->
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xE7EF;"
                                    ToolTipService.ToolTip="Owns this group"
                                    Visibility="{x:Bind IsOwner, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}" />
                            </StackPanel>
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontFamily="Consolas"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind VirtualIp, Mode=OneWay}" />

                            <!--
                                One button rather than several. Copying an
                                address is the common thing, and removing
                                somebody or handing them the group are rare and
                                only there for the owner, which is more than a
                                row this narrow can hold side by side.
                            -->
                            <Button
                                Grid.Column="3"
                                Width="28"
                                Height="28"
                                Padding="0"
                                AutomationProperties.Name="Options"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTipService.ToolTip="Options">
                                <FontIcon FontSize="13" Glyph="&#xE712;" />
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <!--  Away, and so without an address to copy.  -->
                                        <MenuFlyoutItem
                                            Command="{x:Bind CopyAddressCommand}"
                                            Text="Copy address"
                                            Visibility="{x:Bind IsHere, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8C8;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>

                                        <MenuFlyoutSeparator Visibility="{x:Bind ShowManageSeparator, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}" />

                                        <MenuFlyoutItem
                                            Command="{x:Bind AskToMakeOwnerCommand}"
                                            Text="Make owner"
                                            Visibility="{x:Bind CanManage, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE7EF;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem
                                            Command="{x:Bind RemoveCommand}"
                                            Text="Remove from group"
                                            Visibility="{x:Bind CanManage, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE74D;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>

                            <TextBlock
                                Grid.Column="4"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Status, Mode=OneWay}"
                                TextAlignment="Right" />
                        </Grid>

                        <!--
                            Asked in the row, like leaving a group is. Handing
                            the group over is not undone without the other
                            person agreeing to hand it back.
                        -->
                        <StackPanel Spacing="8" Visibility="{x:Bind IsConfirmingOwner, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}">
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind OwnerPrompt, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <StackPanel
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button Command="{x:Bind KeepOwnershipCommand}" Content="Cancel" />
                                <Button Command="{x:Bind MakeOwnerCommand}" Content="Hand over" />
                            </StackPanel>
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!--  Disconnected: the groups you can walk into.  -->
            <ListView
                Grid.Row="1"
                Padding="8,0,8,8"
                ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}"
                SelectionMode="None"
                Visibility="{x:Bind ViewModel.IsConnected, Mode=OneWay, Converter={StaticResource BooleanToCollapsed}}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Padding" Value="10,8" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:GroupListItem">
                        <Grid>
                            <Grid ColumnSpacing="6" Visibility="{x:Bind IsConfirmingLeave, Mode=OneWay, Converter={StaticResource BooleanToCollapsed}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel
                                    Grid.Column="0"
                                    Margin="0,0,4,0"
                                    VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                        <!--  Yours to run, and so yours to change.  -->
                                        <FontIcon
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="&#xE7EF;"
                                            ToolTipService.ToolTip="You own this group"
                                            Visibility="{x:Bind IsOwner, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}" />
                                    </StackPanel>
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Nickname, Mode=OneWay}" />
                                </StackPanel>

                                <!--
                                    Wide enough for either word, so the row does
                                    not jump the moment it is pressed.
                                -->
                                <Button
                                    Grid.Column="1"
                                    MinWidth="104"
                                    Click="OnConnect"
                                    IsEnabled="{x:Bind CanConnect, Mode=OneWay}"
                                    Tag="{x:Bind}">
                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <ProgressRing
                                            Width="14"
                                            Height="14"
                                            IsActive="{x:Bind IsConnecting, Mode=OneWay}"
                                            Visibility="{x:Bind IsConnecting, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}" />
                                        <TextBlock Text="{x:Bind ConnectLabel, Mode=OneWay}" />
                                    </StackPanel>
                                </Button>

                                <!--
                                    Leaving is rare and hard to undo, so it sits
                                    behind the overflow rather than beside
                                    Connect where a mis-click would find it.
                                -->
                                <Button
                                    Grid.Column="2"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    AutomationProperties.Name="More options"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ToolTipService.ToolTip="More options">
                                    <FontIcon FontSize="14" Glyph="&#xE712;" />
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <!--  Yours to change, so reachable without connecting to it first.  -->
                                            <MenuFlyoutItem
                                                Click="OnManageGroupFromList"
                                                Tag="{x:Bind}"
                                                Text="Group settings"
                                                Visibility="{x:Bind IsOwner, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE713;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem
                                                Click="OnStartLeaving"
                                                Tag="{x:Bind}"
                                                Text="Leave group">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE89B;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>

                            <!--
                                The question is asked in the row so that the
                                group being left stays in view, which a dialog
                                over a window this narrow would cover.
                            -->
                            <StackPanel Spacing="8" Visibility="{x:Bind IsConfirmingLeave, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}">
                                <TextBlock
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind LeavePrompt, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <StackPanel
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button Click="OnCancelLeaving" Tag="{x:Bind}" Content="Cancel" />
                                    <Button Click="OnLeave" Tag="{x:Bind}" Content="Leave" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock
                Grid.Row="1"
                Margin="24,0,24,40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Nobody else has connected yet."
                TextAlignment="Center"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.ShowEmptyPeers, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}" />

            <StackPanel
                Grid.Row="1"
                Margin="24,0,24,40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="4"
                Visibility="{x:Bind ViewModel.ShowEmptyGroups, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}">
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="No groups yet" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Create one, then give its name and password to your friends."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <!--
            Failures get the width of the window and as many lines as they need.
            Sharing a row with the buttons cut most of them off after four words.
        -->
        <InfoBar
            Grid.Row="4"
            Margin="12,0,12,8"
            CloseButtonClick="OnDismissMessage"
            IsOpen="{x:Bind ViewModel.Message, Mode=OneWay, Converter={StaticResource NotNullToBoolean}}"
            Message="{x:Bind ViewModel.Message, Mode=OneWay}"
            Severity="Error" />

        <Grid
            Grid.Row="5"
            Padding="16,12"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                Click="OnJoin"
                Content="Join"
                IsEnabled="{x:Bind ViewModel.CanAct, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsConnected, Mode=OneWay, Converter={StaticResource BooleanToCollapsed}}" />

            <Button
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                Click="OnCreate"
                Content="Create group"
                IsEnabled="{x:Bind ViewModel.CanAct, Mode=OneWay}"
                Style="{StaticResource AccentButtonStyle}"
                Visibility="{x:Bind ViewModel.IsConnected, Mode=OneWay, Converter={StaticResource BooleanToCollapsed}}" />

            <Button
                Grid.Column="0"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Stretch"
                Command="{x:Bind ViewModel.DisconnectCommand}"
                Content="Disconnect"
                IsEnabled="{x:Bind ViewModel.CanAct, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsConnected, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}" />
        </Grid>
    </Grid>
</Page>
