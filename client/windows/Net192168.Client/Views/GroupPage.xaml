<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Net192168.Client.Views.GroupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:views="using:Net192168.Client.Views"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    KeyDown="OnKeyDown">

    <!--  Back and the title of this screen are in the window header.  -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  The form, until the group exists.  -->
        <StackPanel
            Grid.Row="0"
            Margin="16,8,16,0"
            Spacing="14"
            Visibility="{x:Bind ViewModel.IsNotDone, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}">

            <!--  Making a group picks its name and look. Joining one takes both as they are.  -->
            <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsCreating, Converter={StaticResource BooleanToVisibility}}">
                <TextBlock Margin="0,0,0,4" Text="Group name &amp; icon" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Width="32"
                        Height="32"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Background="{x:Bind ViewModel.Appearance.Look.Background, Mode=OneWay}"
                        CornerRadius="8">
                        <FontIcon
                            FontSize="16"
                            Foreground="{x:Bind ViewModel.Appearance.Look.Foreground, Mode=OneWay}"
                            Glyph="{x:Bind ViewModel.Appearance.Look.Glyph, Mode=OneWay}" />
                    </Border>

                    <TextBox
                        x:Name="NameBox"
                        Grid.Column="1"
                        PlaceholderText="Friday Night"
                        Text="{x:Bind ViewModel.GroupName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <views:GroupLookPicker Margin="0,4,0,0" Choice="{x:Bind ViewModel.Appearance}" />
            </StackPanel>

            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsJoining, Converter={StaticResource BooleanToVisibility}}">
                <TextBox
                    x:Name="InviteBox"
                    Header="Invite"
                    PlaceholderText="192168.lol/join/…"
                    Text="{x:Bind ViewModel.Invite, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <!--
                    What the invite opens, before agreeing to join it. Being put
                    on somebody's network is worth seeing the name of first, and
                    it is also how a mistyped code shows itself.
                -->
                <Border
                    Padding="12,10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{x:Bind ViewModel.HasFound, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Width="32"
                            Height="32"
                            VerticalAlignment="Center"
                            Background="{x:Bind ViewModel.FoundLook.Background, Mode=OneWay}"
                            CornerRadius="8">
                            <FontIcon
                                FontSize="16"
                                Foreground="{x:Bind ViewModel.FoundLook.Foreground, Mode=OneWay}"
                                Glyph="{x:Bind ViewModel.FoundLook.Glyph, Mode=OneWay}" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind ViewModel.FoundName, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.FoundMembers, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.Hint}"
                TextWrapping="Wrap" />
        </StackPanel>

        <!--
            The group exists, and the only thing left worth doing is sending the
            link. It gets the screen rather than a line under a form, because
            this is the moment the product is for.
        -->
        <StackPanel
            Grid.Row="0"
            Margin="16,8,16,0"
            Spacing="12"
            Visibility="{x:Bind ViewModel.IsDone, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}">

            <StackPanel
                Margin="0,16,0,0"
                HorizontalAlignment="Center"
                Spacing="10">
                <Border
                    Width="48"
                    Height="48"
                    HorizontalAlignment="Center"
                    Background="{x:Bind ViewModel.Appearance.Look.Background, Mode=OneWay}"
                    CornerRadius="12">
                    <FontIcon
                        FontSize="22"
                        Foreground="{x:Bind ViewModel.Appearance.Look.Foreground, Mode=OneWay}"
                        Glyph="{x:Bind ViewModel.Appearance.Look.Glyph, Mode=OneWay}" />
                </Border>
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.DoneHeadline, Mode=OneWay}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Send this to whoever you want in it."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Border
                Margin="0,8,0,0"
                Padding="12,10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <TextBlock
                    FontFamily="Consolas"
                    IsTextSelectionEnabled="True"
                    Text="{x:Bind ViewModel.Link, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </Border>

            <Button
                HorizontalAlignment="Stretch"
                Command="{x:Bind ViewModel.CopyLinkCommand}"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE8C8;" Visibility="{x:Bind ViewModel.JustCopied, Mode=OneWay, Converter={StaticResource BooleanToCollapsed}}" />
                    <FontIcon FontSize="14" Glyph="&#xE73E;" Visibility="{x:Bind ViewModel.JustCopied, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}" />
                    <TextBlock Text="Copy link" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!--
            Failing here keeps the screen and the typing, so this is where it
            says why, with room for the whole sentence.
        -->
        <InfoBar
            Grid.Row="1"
            Margin="12,12,12,0"
            CloseButtonClick="OnDismissError"
            IsOpen="{x:Bind ViewModel.Error, Mode=OneWay, Converter={StaticResource NotNullToBoolean}}"
            Message="{x:Bind ViewModel.Error, Mode=OneWay}"
            Severity="Error" />

        <Grid Grid.Row="2" Padding="16,12">
            <Button
                HorizontalAlignment="Stretch"
                Click="OnSubmit"
                IsEnabled="{x:Bind ViewModel.CanSubmit, Mode=OneWay}"
                Style="{StaticResource AccentButtonStyle}"
                Visibility="{x:Bind ViewModel.IsNotDone, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}">
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <!--
                        Creating a group talks to a server, so the button says
                        it is still going rather than sitting there disabled.
                    -->
                    <ProgressRing
                        Width="14"
                        Height="14"
                        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}" />
                    <TextBlock Text="{x:Bind ViewModel.SubmitLabel}" />
                </StackPanel>
            </Button>

            <Button
                HorizontalAlignment="Stretch"
                Click="OnDone"
                Content="Done"
                Visibility="{x:Bind ViewModel.IsDone, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}" />
        </Grid>
    </Grid>
</Page>
