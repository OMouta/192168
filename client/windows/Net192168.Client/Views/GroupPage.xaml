<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Net192168.Client.Views.GroupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    KeyDown="OnKeyDown">

    <!--  Back and the title of this screen are in the window header.  -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Margin="16,8,16,0"
            Spacing="14">
            <TextBox
                x:Name="NameBox"
                Header="Group name"
                PlaceholderText="Friday Night"
                Text="{x:Bind ViewModel.GroupName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <!--
                PasswordBox does not push its value on every keystroke the way a
                TextBox does, so the change event carries it across.
            -->
            <PasswordBox
                x:Name="PasswordInput"
                Header="Password"
                PasswordChanged="OnPasswordChanged" />

            <TextBox
                Header="Your nickname"
                Text="{x:Bind ViewModel.Nickname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.Hint}"
                TextWrapping="Wrap" />
        </StackPanel>

        <!--
            Failing here keeps the screen and the typing, so this is where it
            says why, with room for the whole sentence.
        -->
        <InfoBar
            Grid.Row="1"
            Margin="12,12,12,0"
            CloseButtonClick="OnDismissError"
            IsOpen="{x:Bind ViewModel.Error, Mode=OneWay, Converter={StaticResource NotNullToBoolean}}"
            Message="{x:Bind ViewModel.Error, Mode=OneWay}"
            Severity="Error" />

        <Grid Grid.Row="2" Padding="16,12">
            <Button
                HorizontalAlignment="Stretch"
                Click="OnSubmit"
                IsEnabled="{x:Bind ViewModel.CanSubmit, Mode=OneWay}"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <!--
                        Creating a group talks to a server, so the button says
                        it is still going rather than sitting there disabled.
                    -->
                    <ProgressRing
                        Width="14"
                        Height="14"
                        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}" />
                    <TextBlock Text="{x:Bind ViewModel.SubmitLabel}" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>
