<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Net192168.Client.Views.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    CloseButtonText="Close"
    PrimaryButtonText="Save"
    Title="Settings">

    <StackPanel Width="300" Spacing="10">
        <TextBox
            Header="Server"
            PlaceholderText="https://api.192168.lol"
            Text="{x:Bind ViewModel.ServerUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock
            FontSize="11"
            Foreground="{ThemeResource TextDim}"
            Text="Where your friends are introduced to you. Leave it alone unless you were given another address."
            TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button
                Padding="14,5"
                Command="{x:Bind ViewModel.TestCommand}"
                Content="Test"
                FontSize="12" />
            <ProgressRing
                Width="16"
                Height="16"
                VerticalAlignment="Center"
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
        </StackPanel>

        <TextBlock
            FontSize="11"
            Foreground="{ThemeResource TextDim}"
            Text="{x:Bind ViewModel.Result, Mode=OneWay}"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.Result, Mode=OneWay, Converter={StaticResource TextToVisibility}}" />
    </StackPanel>
</ContentDialog>
