<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Net192168.Client.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <!--  One shape for every row, so the three read as a list rather than three ideas.  -->
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="12,0,8,0" />
        </Style>
        <Style x:Key="RowDivider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Margin="16,8,16,16" Spacing="16">
            <StackPanel
                Margin="0,12,0,0"
                HorizontalAlignment="Center"
                Spacing="8">
                <Image Height="56" Source="ms-appx:///Assets/wordmark.png" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Version}" />

                <!--
                    Only here when there is a newer version, so the link has to
                    say that itself. Under the version number and nothing else,
                    "Get on GitHub" read as a place to find the source.

                    The release opens in a browser: the app looks for a new
                    version and does not fetch or install one.
                -->
                <HyperlinkButton
                    HorizontalAlignment="Center"
                    NavigateUri="{x:Bind UpdateUrl}"
                    Visibility="{x:Bind HasUpdate, Converter={StaticResource BooleanToVisibility}}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Update available" />
                        <FontIcon FontSize="12" Glyph="&#xE8A7;" />
                    </StackPanel>
                </HyperlinkButton>
            </StackPanel>

            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Puts you and your friends on the same LAN from different networks, so you can play LAN games together."
                TextAlignment="Center"
                TextWrapping="Wrap" />

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <Grid Padding="4,4,8,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Style="{StaticResource RowLabel}"
                            Text="Source code" />
                        <HyperlinkButton
                            Grid.Column="1"
                            Content="GitHub"
                            NavigateUri="https://github.com/OMouta/192168" />
                    </Grid>

                    <Border Style="{StaticResource RowDivider}" />

                    <Grid Padding="4,4,8,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Style="{StaticResource RowLabel}"
                            Text="Website" />
                        <HyperlinkButton
                            Grid.Column="1"
                            Content="192168.lol"
                            NavigateUri="https://192168.lol" />
                    </Grid>

                    <Border Style="{StaticResource RowDivider}" />

                    <!--
                        The one thing worth asking somebody for when the app
                        misbehaves, so it is a button rather than a path to copy
                        out by hand.
                    -->
                    <Grid Padding="4,4,8,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Style="{StaticResource RowLabel}"
                            Text="Log" />
                        <Button
                            Grid.Column="1"
                            Margin="0,4"
                            Click="OnShowLog"
                            Content="Show" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="MIT licensed"
                TextAlignment="Center" />
        </StackPanel>
    </ScrollViewer>
</Page>
