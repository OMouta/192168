<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Net192168.Client.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <!--  One shape for every row, so the three read as a list rather than three ideas.  -->
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="12,0,8,0" />
        </Style>
        <Style x:Key="RowDivider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Margin="16,8,16,16" Spacing="16">
            <StackPanel
                Margin="0,12,0,0"
                HorizontalAlignment="Center"
                Spacing="8">
                <Image Height="56" Source="ms-appx:///Assets/wordmark.png" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Version}" />

                <!--
                    Only here when there is a newer version, so the button has
                    to name it itself. Under the version number and nothing
                    else, "Get on GitHub" read as a place to find the source.
                -->
                <StackPanel
                    HorizontalAlignment="Center"
                    Spacing="8"
                    Visibility="{x:Bind Update.HasUpdate, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}">
                    <Button
                        HorizontalAlignment="Center"
                        Command="{x:Bind Update.InstallCommand}"
                        Content="{x:Bind Update.Label, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}" />

                    <!--  The panel centres its children, so this needs a width.  -->
                    <ProgressBar
                        Width="220"
                        Maximum="100"
                        Value="{x:Bind Update.Percent, Mode=OneWay}"
                        Visibility="{x:Bind Update.IsDownloading, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}" />

                    <TextBlock
                        MaxWidth="260"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Update.Status, Mode=OneWay}"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind Update.Status, Mode=OneWay, Converter={StaticResource TextToVisibility}}" />

                    <HyperlinkButton
                        HorizontalAlignment="Center"
                        Content="Get it on GitHub"
                        NavigateUri="{x:Bind Update.Url, Mode=OneWay}"
                        Visibility="{x:Bind Update.HasFailed, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}" />
                </StackPanel>
            </StackPanel>

            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Puts you and your friends on the same LAN from different networks, so you can play LAN games together."
                TextAlignment="Center"
                TextWrapping="Wrap" />

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <Grid Padding="4,4,8,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Style="{StaticResource RowLabel}"
                            Text="Source code" />
                        <HyperlinkButton
                            Grid.Column="1"
                            Content="GitHub"
                            NavigateUri="https://github.com/OMouta/192168" />
                    </Grid>

                    <Border Style="{StaticResource RowDivider}" />

                    <Grid Padding="4,4,8,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Style="{StaticResource RowLabel}"
                            Text="Website" />
                        <HyperlinkButton
                            Grid.Column="1"
                            Content="192168.lol"
                            NavigateUri="https://192168.lol" />
                    </Grid>

                    <Border Style="{StaticResource RowDivider}" />

                    <!--
                        The one thing worth asking somebody for when the app
                        misbehaves, so it is a button rather than a path to copy
                        out by hand.
                    -->
                    <Grid Padding="4,4,8,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Style="{StaticResource RowLabel}"
                            Text="Log" />
                        <Button
                            Grid.Column="1"
                            Margin="0,4"
                            Click="OnShowLog"
                            Content="Show" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="MIT licensed"
                TextAlignment="Center" />
        </StackPanel>
    </ScrollViewer>
</Page>
