<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Net192168.Client.Views.ManageGroupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Back and the title of this screen are in the window header.  -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Margin="16,8,16,0"
            Spacing="16">

            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Name" />
                <TextBox Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Password" />
                <PasswordBox
                    PlaceholderText="Leave blank to keep it"
                    Password="{x:Bind ViewModel.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <!--
                    The one thing here worth saying, because everybody expects
                    the other. The password is checked when somebody joins and
                    never again, so this stops the next person and moves nobody
                    already in.
                -->
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Nobody already in the group is removed."
                    TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.Status, Mode=OneWay, Converter={StaticResource TextToVisibility}}" />

            <!--
                Last, and asked about in place. Deleting takes the group away
                from everyone in it, so the name being deleted has to stay
                readable while the question is on screen.
            -->
            <HyperlinkButton
                Margin="0,12,0,0"
                Padding="0,4"
                Command="{x:Bind ViewModel.AskToDeleteCommand}"
                Content="Delete this group"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Visibility="{x:Bind ViewModel.IsNotConfirmingDelete, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}" />

            <StackPanel
                Margin="0,12,0,0"
                Spacing="8"
                Visibility="{x:Bind ViewModel.IsConfirmingDelete, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}">
                <TextBlock
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.DeletePrompt}"
                    TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        Click="OnDelete"
                        Content="Delete"
                        IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource NotBoolean}}" />
                    <Button Command="{x:Bind ViewModel.KeepGroupCommand}" Content="Keep" />
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" Padding="16,12">
            <Button
                HorizontalAlignment="Right"
                MinWidth="104"
                Click="OnSave"
                Content="Save"
                IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource NotBoolean}}"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</Page>
