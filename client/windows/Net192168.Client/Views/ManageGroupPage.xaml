<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Net192168.Client.Views.ManageGroupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:views="using:Net192168.Client.Views"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Back and the title of this screen are in the window header.  -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Margin="16,8,16,0"
            Spacing="16">

            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Name" />

                <!--  The group as the list draws it, beside the name it is drawn with.  -->
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Width="32"
                        Height="32"
                        Background="{x:Bind ViewModel.Appearance.Look.Background, Mode=OneWay}"
                        CornerRadius="8">
                        <FontIcon
                            FontSize="16"
                            Foreground="{x:Bind ViewModel.Appearance.Look.Foreground, Mode=OneWay}"
                            Glyph="{x:Bind ViewModel.Appearance.Look.Glyph, Mode=OneWay}" />
                    </Border>

                    <TextBox Grid.Column="1" Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <views:GroupLookPicker Margin="0,4,0,0" Choice="{x:Bind ViewModel.Appearance, Mode=OneWay}" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Invite" />

                <Border
                    Padding="12,10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{x:Bind ViewModel.HasInvite, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}">
                    <TextBlock
                        FontFamily="Consolas"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind ViewModel.InviteLink, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </Border>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.CopyInviteCommand}"
                        IsEnabled="{x:Bind ViewModel.HasInvite, Mode=OneWay}">
                        <StackPanel
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <FontIcon
                                FontSize="14"
                                Glyph="&#xE8C8;"
                                Visibility="{x:Bind ViewModel.JustCopied, Mode=OneWay, Converter={StaticResource BooleanToCollapsed}}" />
                            <FontIcon
                                FontSize="14"
                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                Glyph="&#xE73E;"
                                Visibility="{x:Bind ViewModel.JustCopied, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}" />
                            <TextBlock Text="Copy link" />
                        </StackPanel>
                    </Button>

                    <Button
                        Grid.Column="1"
                        Command="{x:Bind ViewModel.ResetInviteCommand}"
                        Content="New link"
                        IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource NotBoolean}}" />
                </Grid>

                <!--  Everybody expects the other, so this is worth saying.  -->
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="A new link stops the old one. Nobody already in the group is removed."
                    TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.Status, Mode=OneWay, Converter={StaticResource TextToVisibility}}" />

        </StackPanel>

        <!--
            The question sits directly above the button that asked it, and names
            the group, which a dialog over a window this narrow would cover.
        -->
        <StackPanel
            Grid.Row="1"
            Margin="16,12,16,0"
            Spacing="8"
            Visibility="{x:Bind ViewModel.IsConfirmingDelete, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}">
            <TextBlock
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.DeletePrompt}"
                TextWrapping="Wrap" />
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <Button Command="{x:Bind ViewModel.KeepGroupCommand}" Content="Keep" />
                <Button
                    Click="OnDelete"
                    Content="Delete"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource NotBoolean}}" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="2" Padding="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  Opposite Save, where the destructive one goes.  -->
            <!--  Red where it counts: the word, not a block behind it.  -->
            <Button
                Grid.Column="0"
                HorizontalAlignment="Left"
                Command="{x:Bind ViewModel.AskToDeleteCommand}"
                Content="Delete group"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Visibility="{x:Bind ViewModel.IsNotConfirmingDelete, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}" />

            <Button
                Grid.Column="1"
                MinWidth="104"
                Click="OnSave"
                Content="Save"
                IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource NotBoolean}}"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</Page>
