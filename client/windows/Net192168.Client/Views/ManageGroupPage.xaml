<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Net192168.Client.Views.ManageGroupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Back and the title of this screen are in the window header.  -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Margin="16,8,16,0"
            Spacing="16">

            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Name" />
                <TextBox Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Password" />
                <PasswordBox
                    PlaceholderText="Leave blank to keep it"
                    Password="{x:Bind ViewModel.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <!--
                    The one thing here worth saying, because everybody expects
                    the other. The password is checked when somebody joins and
                    never again, so this stops the next person and moves nobody
                    already in.
                -->
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Nobody already in the group is removed."
                    TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.Status, Mode=OneWay, Converter={StaticResource TextToVisibility}}" />

        </StackPanel>

        <!--
            The question sits directly above the button that asked it, and names
            the group, which a dialog over a window this narrow would cover.
        -->
        <StackPanel
            Grid.Row="1"
            Margin="16,12,16,0"
            Spacing="8"
            Visibility="{x:Bind ViewModel.IsConfirmingDelete, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}">
            <TextBlock
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.DeletePrompt}"
                TextWrapping="Wrap" />
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <Button Command="{x:Bind ViewModel.KeepGroupCommand}" Content="Keep" />
                <Button
                    Click="OnDelete"
                    Content="Delete"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource NotBoolean}}" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="2" Padding="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  Opposite Save, where the destructive one goes.  -->
            <!--  Red where it counts: the word, not a block behind it.  -->
            <Button
                Grid.Column="0"
                HorizontalAlignment="Left"
                Command="{x:Bind ViewModel.AskToDeleteCommand}"
                Content="Delete group"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Visibility="{x:Bind ViewModel.IsNotConfirmingDelete, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}" />

            <Button
                Grid.Column="1"
                MinWidth="104"
                Click="OnSave"
                Content="Save"
                IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource NotBoolean}}"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</Page>
