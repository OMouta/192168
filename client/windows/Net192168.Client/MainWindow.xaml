<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Net192168.Client.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="192168">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            The title bar carries the wordmark and settings, level with the
            window buttons, so nothing below has to spend a row on chrome.
        -->
        <Grid x:Name="TitleBarRow" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Image
                Grid.Column="0"
                Height="24"
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Source="ms-appx:///Assets/wordmark.png" />

            <!--
                Anything clickable up here has to be cut out of the drag region
                by hand, or the window swallows the click and acts on it in
                surprising ways. See MainWindow.xaml.cs.
            -->
            <Button
                x:Name="SettingsButton"
                Grid.Column="1"
                Width="32"
                Height="32"
                Margin="8,0,0,0"
                Padding="0"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                AutomationProperties.Name="Settings"
                Click="OnSettings"
                ToolTipService.ToolTip="Settings">
                <FontIcon FontSize="14" Glyph="&#xE713;" />
            </Button>
        </Grid>

        <Frame x:Name="ContentFrame" Grid.Row="1" />
    </Grid>
</Window>
