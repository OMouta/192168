<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Net192168.Client.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="192168">

    <Grid Background="{ThemeResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  The window's own title bar, so it matches the app instead of the system.  -->
        <Grid
            x:Name="TitleBar"
            Grid.Row="0"
            Background="{ThemeResource TitleBarBackground}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <!--  Kept clear for the system caption buttons.  -->
                <ColumnDefinition x:Name="CaptionSpacer" Width="0" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Margin="14,0,0,0"
                VerticalAlignment="Center"
                FontSize="13"
                FontWeight="SemiBold"
                Text="192168" />

            <!--  Settings sits here so no screen has to be spent on it.  -->
            <Button
                x:Name="SettingsButton"
                Grid.Column="2"
                Width="36"
                Height="36"
                Background="Transparent"
                BorderThickness="0"
                Click="OnSettings"
                CornerRadius="0"
                ToolTipService.ToolTip="Settings">
                <FontIcon FontSize="14" Glyph="&#xE713;" />
            </Button>
        </Grid>

        <Frame x:Name="ContentFrame" Grid.Row="1" />
    </Grid>
</Window>
