<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Net192168.Client.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon"
    Title="192168">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <!--  48 is the tall window button height, set in MainWindow.xaml.cs.  -->
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            One header for the whole app, level with the window buttons. Back,
            where the screen is, and settings all live here, so no page below
            spends a row on chrome of its own.
        -->
        <Grid x:Name="TitleBarRow" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  The window drags by the gaps between these buttons. See MainWindow.xaml.cs.  -->
            <Button
                x:Name="BackButton"
                Grid.Column="0"
                Width="32"
                Height="32"
                Margin="8,0,0,0"
                Padding="0"
                VerticalAlignment="Center"
                AutomationProperties.Name="Back"
                Background="Transparent"
                BorderThickness="0"
                Click="OnBack"
                ToolTipService.ToolTip="Back"
                Visibility="Collapsed">
                <Button.KeyboardAccelerators>
                    <!--  Escape and Alt+Left mean back everywhere else in Windows.  -->
                    <KeyboardAccelerator Key="Escape" />
                    <KeyboardAccelerator Key="Left" Modifiers="Menu" />
                </Button.KeyboardAccelerators>
                <FontIcon FontSize="14" Glyph="&#xE72B;" />
            </Button>

            <!--  Home wears the wordmark; every other screen says its own name.  -->
            <Image
                x:Name="Wordmark"
                Grid.Column="1"
                Height="24"
                Margin="16,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Source="ms-appx:///Assets/wordmark.png" />

            <TextBlock
                x:Name="PageTitle"
                Grid.Column="1"
                Margin="6,0,0,0"
                VerticalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Visibility="Collapsed" />

            <Button
                x:Name="SettingsButton"
                Grid.Column="2"
                Width="32"
                Height="32"
                Margin="0,0,4,0"
                Padding="0"
                VerticalAlignment="Center"
                AutomationProperties.Name="Settings"
                Background="Transparent"
                BorderThickness="0"
                Click="OnSettings"
                ToolTipService.ToolTip="Settings">
                <FontIcon FontSize="14" Glyph="&#xE713;" />
            </Button>

            <!--  Ours rather than the system's, at Windows' own size and colours.  -->
            <Button
                x:Name="MinimizeButton"
                Grid.Column="3"
                Width="46"
                Height="48"
                Padding="0"
                AutomationProperties.Name="Minimize"
                BorderThickness="0"
                Click="OnMinimize"
                CornerRadius="0"
                ToolTipService.ToolTip="Minimize">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#20FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#12FFFFFF" />
                </Button.Resources>
                <FontIcon FontSize="10" Glyph="&#xE921;" />
            </Button>

            <Button
                x:Name="CloseButton"
                Grid.Column="4"
                Width="46"
                Height="48"
                Padding="0"
                AutomationProperties.Name="Close"
                BorderThickness="0"
                Click="OnClose"
                CornerRadius="0"
                ToolTipService.ToolTip="Close">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#C42B1C" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#B12A1B" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#E0FFFFFF" />
                </Button.Resources>
                <FontIcon FontSize="10" Glyph="&#xE8BB;" />
            </Button>
        </Grid>

        <Frame x:Name="ContentFrame" Grid.Row="1" />

        <!--
            Closing the window leaves the app here rather than ending it. The
            daemon keeps the tunnels up either way, so quitting outright would
            hide a live connection instead of showing it. The count lives in
            the tooltip, which is where a tray icon says how things are going.
        -->
        <tb:TaskbarIcon
            x:Name="Tray"
            Grid.Row="0"
            IconSource="ms-appx:///Assets/icon.ico"
            LeftClickCommand="{x:Bind ShowWindowCommand}"
            NoLeftClickDelay="True"
            ToolTipText="192168">
            <tb:TaskbarIcon.ContextFlyout>
                <!--
                    Commands, not Click. The flyout is shown from the tray's own
                    window and a Click on an item here never reached the code
                    behind, so the menu did nothing.
                -->
                <MenuFlyout>
                    <MenuFlyoutItem Command="{x:Bind ShowWindowCommand}" Text="Open" />
                    <MenuFlyoutItem
                        x:Name="TrayDisconnect"
                        Command="{x:Bind TrayDisconnectCommand}"
                        Text="Disconnect" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Command="{x:Bind ExitAppCommand}" Text="Exit" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>
    </Grid>
</Window>
