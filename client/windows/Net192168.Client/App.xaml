<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Net192168.Client.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Net192168.Client.Views"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <views:BooleanToVisibility x:Key="BooleanToVisibility" />
            <views:BooleanToCollapsed x:Key="BooleanToCollapsed" />
            <views:NotNullToBoolean x:Key="NotNullToBoolean" />
            <views:TextToVisibility x:Key="TextToVisibility" />
            <views:ConnectionBrush x:Key="ConnectionBrush" />
            <views:NotBoolean x:Key="NotBoolean" />

            <!--
                A ContentDialog stretches its buttons and drops the corner
                radius the rest of the app uses, which reads as two different
                button shapes in one window. These put it back.
            -->
            <Style
                x:Key="DialogButton"
                BasedOn="{StaticResource DefaultButtonStyle}"
                TargetType="Button">
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
            </Style>
            <Style
                x:Key="DialogAccentButton"
                BasedOn="{StaticResource AccentButtonStyle}"
                TargetType="Button">
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
            </Style>

            <!--
                Dark always, rather than following the system. This sits open
                beside a game, and the alternative is two looks to keep right.
                Everything else comes from the standard Fluent styles.
            -->
        </ResourceDictionary>
    </Application.Resources>
</Application>
