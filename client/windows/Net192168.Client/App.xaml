<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Net192168.Client.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Net192168.Client.Views"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <views:BooleanToVisibility x:Key="BooleanToVisibility" />
            <views:BooleanToCollapsed x:Key="BooleanToCollapsed" />
            <views:NotNullToBoolean x:Key="NotNullToBoolean" />
            <views:ConnectionBrush x:Key="ConnectionBrush" />
            <views:TextToVisibility x:Key="TextToVisibility" />

            <!--
                One dark palette, always. A tool you leave open beside a game
                should not glow, and following the system theme would mean two
                looks to get right for no benefit.
            -->
            <SolidColorBrush x:Key="AppBackground" Color="#12141A" />
            <SolidColorBrush x:Key="TitleBarBackground" Color="#0D0F14" />
            <SolidColorBrush x:Key="FooterBackground" Color="#0D0F14" />
            <SolidColorBrush x:Key="CardBackground" Color="#1B1E26" />
            <SolidColorBrush x:Key="CardStroke" Color="#282C36" />
            <SolidColorBrush x:Key="TextDim" Color="#8A90A0" />
            <SolidColorBrush x:Key="Accent" Color="#4DD0A0" />
            <SolidColorBrush x:Key="Offline" Color="#4A505E" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
