<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Net192168.Client.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Net192168.Client.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <views:BooleanToVisibility x:Key="BooleanToVisibility" />
            <views:BooleanToCollapsed x:Key="BooleanToCollapsed" />
            <views:NotNullToBoolean x:Key="NotNullToBoolean" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
