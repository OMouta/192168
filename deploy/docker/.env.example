# Public HTTPS base URL of this deployment. This is the only value users type
# into the desktop app, and where the discovery document is served.
NET192168_PUBLIC_URL=https://lan.example.com

# Optional: comma-separated STUN servers to advertise instead of the default.
# NET192168_STUN=stun:stun.example.com:3478

# Optional: storage DSN. Defaults to SQLite on the mounted volume at
# /data/192168.db. Point it elsewhere only if that volume is not where you
# want the database.
# NET192168_DATABASE_URL=
