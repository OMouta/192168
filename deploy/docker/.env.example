# Public HTTPS base URL of this deployment. This is the only value users paste
# into the desktop app, and where the discovery document is served.
NET192168_PUBLIC_URL=https://192168.lol

# Optional: advertise a different host for the API and realtime channel. Set
# these when discovery is answered on one host and the API lives on another.
# NET192168_API_URL=https://api.192168.lol
# NET192168_REALTIME_URL=wss://api.192168.lol/realtime

# Optional: comma-separated STUN servers to advertise instead of the default.
# NET192168_STUN=stun:stun.example.com:3478

# Optional: storage DSN. Defaults to local SQLite.
# NET192168_DATABASE_URL=
